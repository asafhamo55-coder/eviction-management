# Supabase (project: uetwnmeguarcmbfmurkw)
NEXT_PUBLIC_SUPABASE_URL=https://uetwnmeguarcmbfmurkw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.uetwnmeguarcmbfmurkw.supabase.co:5432/postgres

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LLM (free tier, optional). Defaults to disabled.
# Get a free key at https://console.groq.com
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_ENABLED=false

# Email (Resend free tier — 3k/mo)
RESEND_API_KEY=
EMAIL_FROM=notices@yourdomain.com

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Lob (test mode — does not actually mail)
LOB_API_KEY=test_xxx

# Inngest (free tier for scheduled jobs)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
